#include <iostream>
#include <string>
using namespace std;

class BankAccount {
private:
    string m_numero;
    double m_solde;

public:
    BankAccount() {
        m_numero = "0000";
        m_solde = 0.0;
    }

    BankAccount(const string& numero, double soldeInitial = 0.0) {
        m_numero = numero;
        m_solde = (soldeInitial >= 0) ? soldeInitial : 0.0;
    }

    void deposer(double montant) {
        if (montant > 0) {
            m_solde += montant;
            cout << "Depot effectue." << endl;
        } else {
            cout << "Montant invalide." << endl;
        }
    }

    bool retirer(double montant) {
        if (montant > 0 && montant <= m_solde) {
            m_solde -= montant;
            cout << "Retrait effectue." << endl;
            return true;
        }

        cout << "Retrait impossible." << endl;
        return false;
    }

    void afficher() const {
        cout << "Numero : " << m_numero << endl;
        cout << "Solde : " << m_solde << " DH" << endl;
    }

    string getNumero() const {
        return m_numero;
    }

    double getSolde() const {
        return m_solde;
    }
};

int main() {
    BankAccount compte("12345", 1000.0);

    compte.afficher();

    compte.deposer(500.0);
    compte.retirer(200.0);

    compte.afficher();

    return 0;
}