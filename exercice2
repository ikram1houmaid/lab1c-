
#include <iostream>
#include <string>
#include <vector>
using namespace std;

class Book {
private:
    string m_titre;
    string m_auteur;
    string m_isbn;
    int m_annee;

public:
    Book() {
        m_titre = "";
        m_auteur = "";
        m_isbn = "";
        m_annee = 0;
    }

    Book(const string& titre, const string& auteur,
         const string& isbn, int annee) {
        m_titre = titre;
        m_auteur = auteur;
        m_isbn = isbn;
        m_annee = annee;
    }

    string getTitre() const {
        return m_titre;
    }

    string getAuteur() const {
        return m_auteur;
    }

    string getISBN() const {
        return m_isbn;
    }

    int getAnnee() const {
        return m_annee;
    }

    void afficher() const {
        cout << "Titre : " << m_titre << endl;
        cout << "Auteur : " << m_auteur << endl;
        cout << "ISBN : " << m_isbn << endl;
        cout << "Annee : " << m_annee << endl;
    }
};

class Library {
private:
    vector<Book> m_livres;

public:
    void ajouterLivre(const Book& livre) {
        m_livres.push_back(livre);
        cout << "Livre ajoute." << endl;
    }

    const Book* trouverParISBN(const string& isbn) const {
        for (const Book& livre : m_livres) {
            if (livre.getISBN() == isbn) {
                return &livre;
            }
        }
        return nullptr;
    }

    void listerLivres() const {
        for (const Book& livre : m_livres) {
            livre.afficher();
            cout << "------------------" << endl;
        }
    }
};

int main() {
    Library bibliotheque;

    Book livre1("Le Petit Prince", "Saint-Exupery", "12345", 1943);
    Book livre2("L'Etranger", "Albert Camus", "67890", 1942);

    bibliotheque.ajouterLivre(livre1);
    bibliotheque.ajouterLivre(livre2);

    cout << "\nListe des livres :" << endl;
    bibliotheque.listerLivres();

    cout << "\nRecherche par ISBN :" << endl;
    const Book* resultat = bibliotheque.trouverParISBN("12345");

    if (resultat != nullptr) {
        resultat->afficher();
    } else {
        cout << "Livre introuvable." << endl;
    }

    return 0;
}